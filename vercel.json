{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=/api/:path*" },
    { "source": "/:code([A-Za-z0-9_-]{3,32})", "destination": "/api?__path=/:code" }
  ]
}
